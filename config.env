# Non-secret settings for the cloud gaming rig. Secrets and live resource ids live in secrets/ (gitignored).
NAME=cloud-gaming
REGION=ap-southeast-1          # Singapore: ~10 ms from home, and Deadlock's SEA servers are there
INSTANCE_TYPE=g4dn.8xlarge     # NVIDIA T4, 32 vCPU, 128 GB. 2xlarge = 8 vCPU, 4xlarge = 16; same GPU. deploy.sh resizes in place
VOLUME_GB=150                  # Windows ~30 GB + Deadlock ~40 GB + headroom; billed even while paused
AMI_NAME='Windows_Server-2022-English-Full-Base-*'
